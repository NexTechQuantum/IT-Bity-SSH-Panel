#!/usr/bin/env python3
"""Root-only scheduled full backup sender for IT Bity Panel."""

import http.client
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import socket
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from urllib.parse import quote
from urllib.request import urlopen
import uuid
import zipfile

CONFIG_DIR = Path('/etc/itbity-backup')
CONFIG_FILE = CONFIG_DIR / 'config.json'
STATE_FILE = CONFIG_DIR / 'state.json'
BACKUP_DIR = Path('/var/lib/itbity-backup')
UPLOAD_DIR = BACKUP_DIR / 'uploads'
PROJECT_DIR = Path('/var/www/itbity-ssh-panel')
TIMER_FILE = Path('/etc/systemd/system/itbity-backup.timer')
MAX_TELEGRAM_BYTES = 49 * 1024 * 1024
MAX_RESTORE_BYTES = 50 * 1024 * 1024


def emit(success, **payload):
    print(json.dumps({'success': success, **payload}, ensure_ascii=False))


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {} if default is None else default


def secure_write(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2))
    os.chmod(temporary, 0o600)
    temporary.replace(path)


def status():
    config = read_json(CONFIG_FILE)
    state = read_json(STATE_FILE)
    schedule = config.get('schedule', 'daily:02:00')
    if ':' in schedule and not schedule.startswith(('daily:', 'every:')):
        schedule = f'daily:{schedule}'
    emit(True, configured=bool(config.get('token') and config.get('chat_id')),
         schedule=schedule, chat_id=config.get('chat_id', ''),
         token_configured=bool(config.get('token')), last_run=state.get('last_run'),
         last_success=state.get('last_success'), last_error=state.get('last_error'),
         last_size=state.get('last_size'), running=bool(state.get('running')))


def validate(schedule, token, chat_id):
    if not (re.fullmatch(r'daily:(?:[01]\d|2[0-3]):[0-5]\d', schedule)
            or re.fullmatch(r'every:(?:1|2|4|8|12)', schedule)):
        raise ValueError('Invalid backup schedule')
    if not re.fullmatch(r'\d{6,12}:[A-Za-z0-9_-]{20,}', token):
        raise ValueError('Invalid Telegram bot token')
    if not (re.fullmatch(r'-?\d{5,20}', chat_id) or re.fullmatch(r'@[A-Za-z][A-Za-z0-9_]{4,31}', chat_id)):
        raise ValueError('Invalid channel ID or @channel username')


def telegram_json(token, method, query=''):
    url = f'https://api.telegram.org/bot{quote(token, safe=":")}/{method}{query}'
    with urlopen(url, timeout=25) as response:
        payload = json.loads(response.read())
    if not payload.get('ok'):
        raise RuntimeError(payload.get('description', 'Telegram request failed'))
    return payload


def test_connection(config, notify=True):
    bot = telegram_json(config['token'], 'getMe')['result']
    if notify:
        text = quote('✅ IT Bity backup connection test successful')
        chat = quote(str(config['chat_id']))
        telegram_json(config['token'], 'sendMessage', f'?chat_id={chat}&text={text}')
    return bot.get('username', '')


def configure(schedule, chat_id, token):
    current = read_json(CONFIG_FILE)
    if token == '__KEEP__':
        token = current.get('token', '')
    validate(schedule, token, chat_id)
    test_connection({'token': token, 'chat_id': chat_id}, notify=False)
    secure_write(CONFIG_FILE, {'schedule': schedule, 'chat_id': chat_id, 'token': token})
    if schedule.startswith('daily:'):
        hour, minute = schedule.removeprefix('daily:').split(':')
        timer_rule = f'OnCalendar=*-*-* {hour}:{minute}:00\nPersistent=true'
    else:
        hours = schedule.removeprefix('every:')
        timer_rule = f'OnBootSec=5min\nOnUnitActiveSec={hours}h\nAccuracySec=1min'
    TIMER_FILE.write_text(f'''[Unit]\nDescription=Scheduled IT Bity full backup\n\n[Timer]\n{timer_rule}\nRandomizedDelaySec=30\nUnit=itbity-backup.service\n\n[Install]\nWantedBy=timers.target\n''')
    os.chmod(TIMER_FILE, 0o644)
    subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=True)
    subprocess.run(['/usr/bin/systemctl', 'enable', 'itbity-backup.timer'], check=True, capture_output=True)
    subprocess.run(['/usr/bin/systemctl', 'restart', 'itbity-backup.timer'], check=True, capture_output=True)
    emit(True, message='Backup schedule saved', schedule=schedule, chat_id=chat_id)


def parse_env():
    values = {}
    for raw in (PROJECT_DIR / '.env').read_text().splitlines():
        raw = raw.strip()
        if not raw or raw.startswith('#') or '=' not in raw:
            continue
        key, value = raw.split('=', 1)
        values[key.strip()] = value.strip().strip('"\'')
    return values


def add_tree(archive, source, prefix, excluded=()):
    if not source.exists():
        return
    excluded = set(excluded)
    for path in source.rglob('*'):
        relative = path.relative_to(source)
        if any(part in excluded for part in relative.parts) or path.is_symlink() or not path.is_file():
            continue
        archive.write(path, Path(prefix) / relative)


def inspect_archive(path):
    if not path.is_file() or path.is_symlink() or path.stat().st_size > MAX_RESTORE_BYTES:
        raise ValueError('Invalid backup file or file is larger than 50 MB')
    with zipfile.ZipFile(path) as archive:
        names = archive.namelist()
        required = {'metadata.json', 'database/database.sql'}
        if not required.issubset(names):
            raise ValueError('This is not a valid IT Bity full backup')
        for item in archive.infolist():
            target = Path(item.filename)
            if target.is_absolute() or '..' in target.parts or (item.external_attr >> 16) & 0o170000 == 0o120000:
                raise ValueError('Unsafe path found in backup archive')
        metadata = json.loads(archive.read('metadata.json'))
        return {
            'created_at': metadata.get('created_at'), 'hostname': metadata.get('hostname'),
            'format': metadata.get('format'), 'size': path.stat().st_size,
            'files': len(names), 'has_wireguard': any(name.startswith('system/etc/wireguard/') for name in names),
        }


def stage_restore(source_name):
    source = Path('/tmp') / Path(source_name).name
    if not re.fullmatch(r'itbity-restore-[a-f0-9]{32}\.zip', source.name):
        raise ValueError('Invalid temporary upload name')
    details = inspect_archive(source)
    UPLOAD_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    for old in UPLOAD_DIR.glob('*.zip'):
        if old.stat().st_mtime < datetime.now().timestamp() - 86400:
            old.unlink(missing_ok=True)
    restore_id = uuid.uuid4().hex
    destination = UPLOAD_DIR / f'{restore_id}.zip'
    shutil.move(source, destination)
    os.chmod(destination, 0o600)
    emit(True, restore_id=restore_id, backup=details)


def restore_archive(restore_id, mode):
    if not re.fullmatch(r'[a-f0-9]{32}', restore_id) or mode not in {'data', 'full'}:
        raise ValueError('Invalid restore request')
    source = UPLOAD_DIR / f'{restore_id}.zip'
    inspect_archive(source)
    work = Path(tempfile.mkdtemp(prefix='restore-', dir=BACKUP_DIR))
    safety = create_archive()
    safety_path = BACKUP_DIR / f'safety-before-restore-{datetime.now().strftime("%Y%m%d-%H%M%S")}.zip'
    safety.replace(safety_path)
    try:
        with zipfile.ZipFile(source) as archive:
            archive.extractall(work)
        env = parse_env()
        defaults = work / 'restore-db.cnf'
        defaults.write_text('[client]\n' + f'user={env.get("DB_USER", "itbity")}\npassword={env.get("DB_PASSWORD", "")}\nhost={env.get("DB_HOST", "localhost")}\n')
        os.chmod(defaults, 0o600)
        client = shutil.which('mariadb') or shutil.which('mysql')
        if not client:
            raise RuntimeError('MariaDB client is not installed')
        with (work / 'database/database.sql').open('rb') as database:
            subprocess.run([client, f'--defaults-extra-file={defaults}', env.get('DB_NAME', 'itbitysshpanel')],
                           stdin=database, stderr=subprocess.PIPE, check=True)
        for relative, destination in (
            ('system/etc/itbity-wireguard', Path('/etc/itbity-wireguard')),
            ('system/etc/wireguard', Path('/etc/wireguard')),
        ):
            restored = work / relative
            if restored.exists():
                destination.mkdir(parents=True, exist_ok=True, mode=0o700)
                shutil.copytree(restored, destination, dirs_exist_ok=True)
                os.chmod(destination, 0o700)
                for secured in destination.rglob('*'):
                    if not secured.is_symlink():
                        os.chmod(secured, 0o700 if secured.is_dir() else 0o600)
        if mode == 'full' and (work / 'panel').exists():
            shutil.copytree(work / 'panel', PROJECT_DIR, dirs_exist_ok=True)
            account = pwd.getpwnam('www-data')
            for path in PROJECT_DIR.rglob('*'):
                if not path.is_symlink():
                    os.chown(path, account.pw_uid, account.pw_gid)
        source.unlink(missing_ok=True)
        subprocess.run(['/usr/bin/systemctl', 'try-restart', 'wg-quick@wg0.service'], check=False)
        subprocess.run(['/usr/bin/systemctl', 'restart', '--no-block', 'itbity-ssh-panel.service'], check=False)
        emit(True, message='Backup restored successfully', safety_backup=str(safety_path), mode=mode)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def create_archive():
    BACKUP_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    work = Path(tempfile.mkdtemp(prefix='work-', dir=BACKUP_DIR))
    stamp = datetime.now().strftime('%Y%m%d-%H%M%S')
    archive_path = BACKUP_DIR / f'itbity-full-{socket.gethostname()}-{stamp}.zip'
    try:
        env = parse_env()
        defaults = work / 'db.cnf'
        defaults.write_text('[client]\n' + f'user={env.get("DB_USER", "itbity")}\npassword={env.get("DB_PASSWORD", "")}\nhost={env.get("DB_HOST", "localhost")}\n')
        os.chmod(defaults, 0o600)
        dump = work / 'database.sql'
        dump_binary = shutil.which('mariadb-dump') or shutil.which('mysqldump')
        if not dump_binary:
            raise RuntimeError('mariadb-dump is not installed')
        with dump.open('wb') as output:
            subprocess.run([dump_binary, f'--defaults-extra-file={defaults}', '--single-transaction',
                            '--routines', '--events', env.get('DB_NAME', 'itbitysshpanel')],
                           stdout=output, stderr=subprocess.PIPE, check=True)
        defaults.unlink(missing_ok=True)
        (work / 'metadata.json').write_text(json.dumps({
            'created_at': datetime.now(timezone.utc).isoformat(), 'hostname': socket.gethostname(),
            'panel_version': 'git', 'format': 1,
        }, indent=2))
        with zipfile.ZipFile(archive_path, 'w', zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
            archive.write(dump, 'database/database.sql')
            archive.write(work / 'metadata.json', 'metadata.json')
            add_tree(archive, PROJECT_DIR, 'panel', {'venv', '.git', '__pycache__', '.pytest_cache'})
            add_tree(archive, Path('/etc/itbity-wireguard'), 'system/etc/itbity-wireguard')
            add_tree(archive, Path('/etc/wireguard'), 'system/etc/wireguard')
            for path in (Path('/etc/ssh/sshd_config'), Path('/etc/sudoers.d/itbity-panel')):
                if path.exists():
                    archive.write(path, f'system{path}')
        os.chmod(archive_path, 0o600)
        if archive_path.stat().st_size > MAX_TELEGRAM_BYTES:
            raise RuntimeError(f'Backup is larger than Telegram 50 MB limit ({archive_path.stat().st_size} bytes)')
        return archive_path
    finally:
        shutil.rmtree(work, ignore_errors=True)


def send_document(config, path):
    boundary = '----ITBity' + uuid.uuid4().hex
    caption = f'IT Bity full backup\nHost: {socket.gethostname()}\nCreated: {datetime.now().isoformat(timespec="seconds")}'
    before = (f'--{boundary}\r\nContent-Disposition: form-data; name="chat_id"\r\n\r\n{config["chat_id"]}\r\n'
              f'--{boundary}\r\nContent-Disposition: form-data; name="caption"\r\n\r\n{caption}\r\n'
              f'--{boundary}\r\nContent-Disposition: form-data; name="document"; filename="{path.name}"\r\n'
              f'Content-Type: application/zip\r\n\r\n').encode()
    after = f'\r\n--{boundary}--\r\n'.encode()
    connection = http.client.HTTPSConnection('api.telegram.org', timeout=180)
    endpoint = f'/bot{config["token"]}/sendDocument'
    connection.putrequest('POST', endpoint)
    connection.putheader('Content-Type', f'multipart/form-data; boundary={boundary}')
    connection.putheader('Content-Length', str(len(before) + path.stat().st_size + len(after)))
    connection.endheaders()
    connection.send(before)
    with path.open('rb') as source:
        while chunk := source.read(1024 * 1024):
            connection.send(chunk)
    connection.send(after)
    response = connection.getresponse()
    payload = json.loads(response.read())
    if response.status != 200 or not payload.get('ok'):
        raise RuntimeError(payload.get('description', f'Telegram HTTP {response.status}'))


def run_backup():
    config = read_json(CONFIG_FILE)
    if not config.get('token') or not config.get('chat_id'):
        raise RuntimeError('Telegram backup is not configured')
    archive = None
    state = {'last_run': datetime.now(timezone.utc).isoformat(), 'last_success': None, 'running': True}
    secure_write(STATE_FILE, state)
    try:
        archive = create_archive()
        state['last_size'] = archive.stat().st_size
        send_document(config, archive)
        state.update(last_success=True, last_error=None, running=False)
        emit(True, message='Full backup sent to Telegram', size=state['last_size'])
    except Exception as error:
        state.update(last_success=False, last_error=str(error), running=False)
        raise
    finally:
        secure_write(STATE_FILE, state)
        if archive:
            archive.unlink(missing_ok=True)


def main():
    if os.geteuid() != 0:
        raise RuntimeError('This helper must run as root')
    command = sys.argv[1] if len(sys.argv) > 1 else ''
    if command == 'status':
        status()
    elif command == 'configure' and len(sys.argv) == 4:
        configure(sys.argv[2], sys.argv[3], sys.stdin.read().strip() or '__KEEP__')
    elif command == 'test':
        config = read_json(CONFIG_FILE)
        emit(True, message='Telegram test sent', bot=test_connection(config))
    elif command == 'trigger':
        subprocess.run(['/usr/bin/systemctl', 'start', '--no-block', 'itbity-backup.service'], check=True)
        emit(True, message='Full backup started in background')
    elif command == 'stage' and len(sys.argv) == 3:
        stage_restore(sys.argv[2])
    elif command == 'restore' and len(sys.argv) == 4:
        restore_archive(sys.argv[2], sys.argv[3])
    elif command == 'restore-trigger' and len(sys.argv) == 4:
        restore_id, mode = sys.argv[2], sys.argv[3]
        if not re.fullmatch(r'[a-f0-9]{32}', restore_id) or mode not in {'data', 'full'}:
            raise ValueError('Invalid restore request')
        subprocess.run(['/usr/bin/systemd-run', '--unit', f'itbity-restore-{restore_id[:8]}',
                        '--collect', '/usr/local/sbin/itbity-backup', 'restore', restore_id, mode],
                       check=True, capture_output=True)
        emit(True, message='Restore started in background', restore_id=restore_id, mode=mode)
    elif command == 'run':
        run_backup()
    else:
        raise ValueError('Usage: itbity-backup status|configure SCHEDULE CHAT_ID|test|trigger|run|stage FILE|restore ID MODE|restore-trigger ID MODE')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        emit(False, message=str(error))
        sys.exit(1)
